        Callback = function(v) config.height = v; saveConfig() end,
    })
    local speedSlider = BlackHoleTab:Slider({
        Title = "旋转速度", Step = 1,
        Value = {Min = 0, Max = 100, Default = config.rotationSpeed},
        Callback = function(v) config.rotationSpeed = v; saveConfig() end,
    })
    local forceSlider = BlackHoleTab:Slider({
        Title = "吸附力量", Step = 100,
        Value = {Min = 0, Max = 10000, Default = config.attractionStrength},
        Callback = function(v) config.attractionStrength = v; saveConfig() end,
    })

    BlackHoleTab:Button({
        Title = "🔄 恢复默认配置",
        Desc = "半径 50 / 高度 100 / 速度 10 / 力量 1000",
        Callback = function()
            config.radius = 50
            config.height = 100
            config.rotationSpeed = 10
            config.attractionStrength = 1000
            pcall(function() radiusSlider:Set(50) end)
            pcall(function() heightSlider:Set(100) end)
            pcall(function() speedSlider:Set(10) end)
            pcall(function() forceSlider:Set(1000) end)
            saveConfig()
            WindUI:Notify({ Title = "🔄 已恢复默认", Content = "黑洞配置已重置", Duration = 2, Icon = "refresh-cw" })
        end,
    })
end)
