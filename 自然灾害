Tabs.Esp:Section({Title = "玩家透视"})
local ESP_CFG = { Enabled = false, Box = false, Name = false, Health = false, Distance = false, TracerTop = false, TracerBottom = false }
local ESP_Cache, ESP_Conn = {}, nil
local function ESP_clean() for _, d in pairs(ESP_Cache) do for _, o in pairs(d) do pcall(function() o:Remove() end) end end ESP_Cache = {} end
local function ESP_new(p)
    if ESP_Cache[p] then return ESP_Cache[p] end
    local d = { Box = Drawing.new("Square"), Name = Drawing.new("Text"), Health = Drawing.new("Text"), Distance = Drawing.new("Text"), TracerTop = Drawing.new("Line"), TracerBottom = Drawing.new("Line") }
    d.Box.Thickness = 1; d.Box.Filled = false; d.Box.Transparency = 1; d.Box.Color = Color3.fromRGB(255, 255, 255)
    d.Name.Size = 14; d.Name.Center = true; d.Name.Outline = true; d.Name.Color = Color3.fromRGB(255, 255, 255)
    d.Health.Size = 12; d.Health.Outline = true; d.Health.Color = Color3.fromRGB(0, 255, 0)
    d.Distance.Size = 12; d.Distance.Center = true; d.Distance.Outline = true; d.Distance.Color = Color3.fromRGB(255, 255, 0)
    d.TracerTop.Thickness = 1; d.TracerTop.Color = Color3.fromRGB(255, 255, 255)
    d.TracerBottom.Thickness = 1; d.TracerBottom.Color = Color3.fromRGB(255, 255, 255)
    for _, o in pairs(d) do o.Visible = false end
    ESP_Cache[p] = d; return d
end
local function ESP_hide(p) local d = ESP_Cache[p]; if not d then return end; for _, o in pairs(d) do o.Visible = false end end
local function ESP_start()
    if ESP_Conn then ESP_Conn:Disconnect() end
    ESP_Conn = RunService.RenderStepped:Connect(function()
        if not ESP_CFG.Enabled then ESP_clean() return end
        local cam = Workspace.CurrentCamera; if not cam then return end
        local mePos = cam.CFrame.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local c = p.Character; local h = c and c:FindFirstChildOfClass("Humanoid"); local r = c and c:FindFirstChild("HumanoidRootPart"); local hd = c and c:FindFirstChild("Head")
            if not (h and r and hd and h.Health > 0) then ESP_hide(p) continue end
            local rp, onScr = cam:WorldToViewportPoint(r.Position); local hp = cam:WorldToViewportPoint(hd.Position + Vector3.new(0, 0.6, 0))
            if not onScr then ESP_hide(p) continue end
            local d = ESP_new(p); local hh = math.abs(rp.Y - hp.Y) * 2.4; local ww = hh * 0.55; local tl = Vector2.new(rp.X - ww / 2, rp.Y - hh / 2)
            if ESP_CFG.Box then d.Box.Visible = true; d.Box.Size = Vector2.new(ww, hh); d.Box.Position = tl; d.Box.Color = Color3.fromRGB(255, 255, 255) else d.Box.Visible = false end
            if ESP_CFG.Name then d.Name.Visible = true; d.Name.Position = Vector2.new(rp.X, tl.Y - 18); d.Name.Text = p.DisplayName else d.Name.Visible = false end
            if ESP_CFG.Health then d.Health.Visible = true; d.Health.Position = Vector2.new(tl.X - 44, tl.Y); d.Health.Text = string.format("HP:%d", math.floor(h.Health + 0.5)) else d.Health.Visible = false end
            if ESP_CFG.Distance then d.Distance.Visible = true; local dist = (r.Position - mePos).Magnitude; d.Distance.Position = Vector2.new(rp.X, tl.Y + hh + 4); d.Distance.Text = string.format("[%dm]", math.floor(dist)) else d.Distance.Visible = false end
            if ESP_CFG.TracerTop then d.TracerTop.Visible = true; d.TracerTop.From = Vector2.new(cam.ViewportSize.X / 2, 0); d.TracerTop.To = Vector2.new(rp.X, rp.Y) else d.TracerTop.Visible = false end
            if ESP_CFG.TracerBottom then d.TracerBottom.Visible = true; d.TracerBottom.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y); d.TracerBottom.To = Vector2.new(rp.X, rp.Y) else d.TracerBottom.Visible = false end
        end
    end)
end
